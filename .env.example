# --- TinaCloud (app.tina.io — un projet isolé PAR CLIENT) ---
NEXT_PUBLIC_TINA_CLIENT_ID=***
TINA_TOKEN=***
# Branche suivie par TinaCloud (souvent main). Détectée automatiquement sur Vercel.
NEXT_PUBLIC_TINA_BRANCH=main

# --- Site ---
# URL publique du site (metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.lestablesdelafontainetoulon.fr

# --- Formulaire de contact (optionnel) ---
# Sans clé, les messages sont journalisés mais aucun email ne part.
RESEND_API_KEY=
CONTACT_FROM=site@lestablesdelafontainetoulon.fr
